.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Third-party reference material (NXTway-GS File Exchange #19147), kept
# locally for cross-checking sim/plant.py against the source, not redistributed.
/nxtway_gs/
/license.txt

# Graphify: graphify-out/ itself is meant to be committed (shared code graph),
# but per-machine LLM cost tracking and local query cache are not.
/graphify-out/cost.json
/graphify-out/cache/

# experiments/run_batch.py output: regenerable (steps.parquet alone is ~150MB
# for the default 210-episode batch), not source.
/experiments/results/

# analysis/animate.py output: regenerable demo video, not source. Delivered
# to the user directly rather than committed -- ask before changing this if a
# rendered demo needs to live in git.
/analysis/results/
